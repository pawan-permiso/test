{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "SAMPLE Permiso Sentinel onboarding template. Creates a Data Collection Endpoint, a custom _CL table, a Data Collection Rule for the Logs Ingestion API, and grants the Permiso service principal Monitoring Metrics Publisher on the DCR. Outputs the DCE ingestion URI, DCR immutable ID, and stream name. For testing only - schema is a representative subset, not the full 31-column AlertInstance model."
  },
  "parameters": {
    "workspaceName": {
      "type": "string",
      "metadata": {
        "description": "Name of an EXISTING Log Analytics workspace in this resource group (the destination for ingested alerts)."
      }
    },
    "spObjectId": {
      "type": "string",
      "metadata": {
        "description": "Object ID of the Permiso service principal in this tenant (Enterprise Applications -> Permiso app -> Object ID). Pre-injected by the Permiso onboarding page."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": { "description": "Region for the DCE and DCR." }
    },
    "namePrefix": {
      "type": "string",
      "defaultValue": "permiso",
      "metadata": { "description": "Prefix for the DCE and DCR resource names." }
    },
    "tableName": {
      "type": "string",
      "defaultValue": "AlertInstance_CL",
      "metadata": { "description": "Custom table name. Must end in _CL." }
    }
  },
  "variables": {
    "dceName": "[format('{0}-dce', parameters('namePrefix'))]",
    "dcrName": "[format('{0}-dcr', parameters('namePrefix'))]",
    "streamName": "[format('Custom-{0}', parameters('tableName'))]",
    "workspaceResourceId": "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('workspaceName'))]",
    "metricsPublisherRoleId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '3913510d-42f4-4e42-8a64-420c390055eb')]"
  },
  "resources": [
    {
      "type": "Microsoft.Insights/dataCollectionEndpoints",
      "apiVersion": "2022-06-01",
      "name": "[variables('dceName')]",
      "location": "[parameters('location')]",
      "properties": {
        "networkAcls": { "publicNetworkAccess": "Enabled" }
      }
    },
    {
      "type": "Microsoft.OperationalInsights/workspaces/tables",
      "apiVersion": "2022-10-01",
      "name": "[format('{0}/{1}', parameters('workspaceName'), parameters('tableName'))]",
      "properties": {
        "schema": {
          "name": "[parameters('tableName')]",
          "columns": [
            { "name": "TimeGenerated",        "type": "dateTime" },
            { "name": "AlertId",              "type": "string" },
            { "name": "AlertName",            "type": "string" },
            { "name": "Severity",             "type": "string" },
            { "name": "IdentityName",         "type": "string" },
            { "name": "IdentityExternalId",   "type": "string" },
            { "name": "TriggerSignals",       "type": "dynamic" },
            { "name": "MitreTactics",         "type": "dynamic" },
            { "name": "PermisoOpen",          "type": "boolean" },
            { "name": "PermisoTenantId",      "type": "string" },
            { "name": "PermisoIntegrationId", "type": "string" },
            { "name": "IngestionVersion",     "type": "string" }
          ]
        }
      }
    },
    {
      "type": "Microsoft.Insights/dataCollectionRules",
      "apiVersion": "2022-06-01",
      "name": "[variables('dcrName')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Insights/dataCollectionEndpoints', variables('dceName'))]",
        "[resourceId('Microsoft.OperationalInsights/workspaces/tables', parameters('workspaceName'), parameters('tableName'))]"
      ],
      "properties": {
        "dataCollectionEndpointId": "[resourceId('Microsoft.Insights/dataCollectionEndpoints', variables('dceName'))]",
        "streamDeclarations": {
          "[variables('streamName')]": {
            "columns": [
              { "name": "TimeGenerated",        "type": "datetime" },
              { "name": "AlertId",              "type": "string" },
              { "name": "AlertName",            "type": "string" },
              { "name": "Severity",             "type": "string" },
              { "name": "IdentityName",         "type": "string" },
              { "name": "IdentityExternalId",   "type": "string" },
              { "name": "TriggerSignals",       "type": "dynamic" },
              { "name": "MitreTactics",         "type": "dynamic" },
              { "name": "PermisoOpen",          "type": "boolean" },
              { "name": "PermisoTenantId",      "type": "string" },
              { "name": "PermisoIntegrationId", "type": "string" },
              { "name": "IngestionVersion",     "type": "string" }
            ]
          }
        },
        "destinations": {
          "logAnalytics": [
            {
              "workspaceResourceId": "[variables('workspaceResourceId')]",
              "name": "laDestination"
            }
          ]
        },
        "dataFlows": [
          {
            "streams": [ "[variables('streamName')]" ],
            "destinations": [ "laDestination" ],
            "transformKql": "source",
            "outputStream": "[variables('streamName')]"
          }
        ]
      }
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(resourceId('Microsoft.Insights/dataCollectionRules', variables('dcrName')), parameters('spObjectId'), variables('metricsPublisherRoleId'))]",
      "scope": "[format('Microsoft.Insights/dataCollectionRules/{0}', variables('dcrName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Insights/dataCollectionRules', variables('dcrName'))]"
      ],
      "properties": {
        "roleDefinitionId": "[variables('metricsPublisherRoleId')]",
        "principalId": "[parameters('spObjectId')]",
        "principalType": "ServicePrincipal"
      }
    }
  ],
  "outputs": {
    "dceLogsIngestionUri": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Insights/dataCollectionEndpoints', variables('dceName')), '2022-06-01').logsIngestion.endpoint]"
    },
    "dcrImmutableId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Insights/dataCollectionRules', variables('dcrName')), '2022-06-01').immutableId]"
    },
    "streamName": {
      "type": "string",
      "value": "[variables('streamName')]"
    }
  }
}
